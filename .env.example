# AI Pipeline — Google Gemini
# Without this key, the pipeline uses deterministic fallback actions.
VITE_GEMINI_API_KEY=

# Supabase
# Get these from your Supabase project dashboard → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Feature flag — set to "true" to use Supabase instead of MSW mocks
VITE_USE_SUPABASE=false
