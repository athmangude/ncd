VITE_SUPERTOKENS_APP_NAME=
VITE_SUPERTOKENS_API_DOMAIN=
VITE_SUPERTOKENS_WEBSITE_DOMAIN=
VITE_SUPERTOKENS_API_BASE_PATH=
VITE_SUPERTOKENS_WEBSITE_BASE_PATH=
VITE_API_BASE_URL=
# Session token transfer method for SuperTokens authentication.
# "cookie" (default) — tokens are sent via cookies. Use this in production/staging
#   where the frontend and API share the same domain.
# "header" — tokens are sent via Authorization headers. Use this for local development
#   when the frontend (localhost) connects to a remote API (e.g. api.jireh-dev.pro),
#   since browsers block third-party cookies across different domains.
# Leave empty or omit to default to "cookie".
VITE_SESSION_TOKEN_TRANSFER_METHOD=
VITE_TIMEZONE=Africa/Nairobi
